# NOAA Data Collector Configuration

# Data collection interval in seconds (default: 3600 = 1 hour)
COLLECTION_INTERVAL=3600

# Timezone for data timestamps
TZ=America/Anchorage

# Data directory (mounted as volume)
DATA_DIR=/app/data

# NDBC Buoy Stations (comma-separated list)
# Examples: 46073,46035 (Bering Sea buoys)
#           41001,41002 (Atlantic buoys)
#           51000,51001 (Pacific buoys)
BUOY_STATIONS=46073,46035

# CO-OPS Tide Station
# Examples: 9464212 (Unalaska, AK)
#           8454000 (Providence, RI)
#           9414290 (San Francisco, CA)
TIDE_STATION=9464212
